// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  admin
  therapeute
}

enum Status {
  programmé
  confirmé
  terminé
  annulé
}

enum ServiceType {
  TYPE1
  TYPE2
}

enum MovementType {
  OUT
  IN
}



enum BienType {
  SERVICE
  PRODUIT
}

enum WorkflowStatus {
  IN_PROGRESS
  COMPLETED
}

model Utilisateur {
  id               Int       @id @default(autoincrement())
  CIN              String    @unique
  nom              String
  prenom           String
  date_naissance   DateTime
  adresse          String
  numero_telephone String
  email            String    @unique
  password         String
  role             Role
  created_at       DateTime  @default(now())
  updated_at   DateTime     @updatedAt

  // Relations
  clients          Client[]  @relation("UtilisateurClients")
  rendez_vous      rendez_vous[]
  documentTemplates document_templates[]
  documents        document[]
  // services         service[]
  biensCreated      bien[]             @relation("BienCreePar")     
  biensTherapeute   bien[]             @relation("BienTherapeute")
  factures         facture[]
  factureBiens     facture_bien[]
  paiements        paiment[]
  scanned_Documents scannedDocument[]
  workflowsCreated   Workflow[] @relation("WorkflowCreePar")

}

model Entreprise {
  id         Int      @id @default(autoincrement())
  ICE        String   
  CNSS       String   
  RC         String   
  IF         String   
  RIB        String   
  patente    String   
  adresse    String
  email      String?
  numero_telephone String?
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt
}

model Client {
  id               Int       @id @default(autoincrement())
  CIN              String    @unique
  nom              String
  prenom           String
  date_naissance   DateTime
  adresse          String
  numero_telephone String
  email            String
  groupe_sanguin   String
  antecedents      String?
  allergies        String?
  commentaire      String?
  created_at       DateTime @default(now())
  updated_at   DateTime     @updatedAt
  Cree_par         String

  utilisateur      Utilisateur @relation(fields: [Cree_par], references: [CIN], name: "UtilisateurClients")

  rendez_vous      rendez_vous[]
  documents        document[]
  scanned_Documents scannedDocument[]
  factures         facture[]
  workflows          Workflow[]
}

model rendez_vous {
  id                Int       @id @default(autoincrement())
  CIN               String
  sujet             String
  soin_id     Int
  date_rendez_vous  DateTime
  created_at        DateTime  @default(now())
  Cree_par          String
  status            Status
  cabinet           String @default("Biohacking")
  updated_at   DateTime     @updatedAt

  client            Client      @relation(fields: [CIN], references: [CIN])
  utilisateur       Utilisateur @relation(fields: [Cree_par], references: [CIN])
  bien     bien     @relation(fields: [soin_id], references: [id])
 workflow           Workflow?

}

model document_templates {
  id            Int       @id @default(autoincrement())
  name          String
  sections_json Json
  Cree_par      String

  utilisateur   Utilisateur @relation(fields: [Cree_par], references: [CIN])
  documents     document[]
  created_at DateTime @default(now())
}

model document {
  id         Int       @id @default(autoincrement())
  template_id Int
  CIN        String
  data_json Json
  Cree_par   String
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt

  template   document_templates @relation(fields: [template_id], references: [id])
  client     Client             @relation(fields: [CIN], references: [CIN])
  utilisateur Utilisateur       @relation(fields: [Cree_par], references: [CIN])
}

model scannedDocument {
  id        Int      @id @default(autoincrement())
  title     String
  filePath  String   
  CIN        String
  description String?
  Cree_par   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client             @relation(fields: [CIN], references: [CIN])
  utilisateur Utilisateur       @relation(fields: [Cree_par], references: [CIN])
}

