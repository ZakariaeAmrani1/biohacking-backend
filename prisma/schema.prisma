model bien {
  id       Int       @id @default(autoincrement())
  Nom      String
  bien_type BienType
  Type     String
  prix     Float
  stock    Int
  cabinet  String @default("Biohacking")
  Cree_par String
  therapeute String? 
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt

  utilisateur Utilisateur @relation("BienCreePar", fields: [Cree_par], references: [CIN])
  therapeuteUser Utilisateur? @relation("BienTherapeute", fields: [therapeute], references: [CIN])

  factureBiens facture_bien[]

  rendez_vous rendez_vous[]
}

model facture {
  id         Int       @id @default(autoincrement())
  CIN        String
  date       DateTime
  prix_total Float
  statut     String
  notes      String?
  Cree_par   String
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt 
  date_paiement DateTime?
  methode_paiement String?
  cheque_numero String?
  cheque_banque String?
  cheque_date_tirage DateTime?

  client     Client      @relation(fields: [CIN], references: [CIN])
  utilisateur Utilisateur @relation(fields: [Cree_par], references: [CIN])
  factureBiens facture_bien[]
  paiements   paiment[]
  workflow           Workflow?
}

model facture_bien {
  id          Int       @id @default(autoincrement())
  id_facture  Int?
  id_bien     Int
  type_bien   String
  quantite    Int
  prix     Float
  Cree_par    String
  movementType       MovementType @default(OUT)
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt

  facture     facture?    @relation(fields: [id_facture], references: [id])
  bien     bien     @relation(fields: [id_bien], references: [id])
  utilisateur Utilisateur @relation(fields: [Cree_par], references: [CIN])

  // We can't directly relate to both service and produit on same field,
  // so handle manually in logic
}

model paiment {
  id             Int       @id @default(autoincrement())
  id_facture     Int
  date           DateTime
  montant_totale Float
  Cree_par       String
  created_at DateTime @default(now())
  updated_at   DateTime     @updatedAt 

  facture        facture     @relation(fields: [id_facture], references: [id])
  utilisateur    Utilisateur @relation(fields: [Cree_par], references: [CIN])
}

model Workflow {
  id               Int            @id @default(autoincrement())
  
  // Required relationships
  client_CIN       String
  rendez_vous_id   Int            @unique // One workflow per appointment usually
  
  // Optional relationship
  facture_id       Int?           @unique // One workflow per invoice
  
  status           WorkflowStatus @default(IN_PROGRESS)
  
  // Metadata
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  Cree_par         String

  // Relations
  client           Client         @relation(fields: [client_CIN], references: [CIN])
  rendez_vous      rendez_vous    @relation(fields: [rendez_vous_id], references: [id])
  facture          facture?       @relation(fields: [facture_id], references: [id])
  utilisateur      Utilisateur    @relation("WorkflowCreePar", fields: [Cree_par], references: [CIN])
}
